{
  "name": "aster-crm-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 6969",
    "build": "next build",
    "start": "next start --port 6969",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "check:demo": "node scripts/check-demo-boundaries.mjs",
    "test:boundary-guard": "node --test scripts/check-demo-boundaries.test.mjs",
    "test:check": "npm run check:demo && npm run test:boundary-guard && npm run test:unit"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
